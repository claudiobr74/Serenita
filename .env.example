# ---------------------------------------------------------------------------
# Serenità — variáveis de ambiente
#
# Copie para `.env.local` e preencha. `.env.local` está no .gitignore.
# NUNCA faça commit de secrets.
#
# NEXT_PUBLIC_*  -> embutido no bundle do cliente. Público por definição.
# Todo o resto   -> server-only. Nunca acessível pelo browser.
# ---------------------------------------------------------------------------

# ============================================================================
# Supabase — PÚBLICO
# ============================================================================

# URL do projeto. Ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (anon). Segura no cliente: opera sempre sob RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================================
# Supabase — SERVER-ONLY
# ============================================================================

# Chave secret (service_role). CONTORNA RLS — acesso irrestrito a prontuário.
#
# Nunca prefixe com NEXT_PUBLIC_. Nunca use em Client Component.
# Uso restrito a Edge Functions e route handlers onde contornar RLS é o
# comportamento pretendido (ex.: webhook do Google Calendar, sem sessão de
# usuário). Ver docs/adr/001-multi-tenancy.md.
SUPABASE_SECRET_KEY=

# ============================================================================
# E-mail transacional — server-only
#
# ATENÇÃO: e-mail do Serenità NUNCA carrega conteúdo clínico. Ele repousa em
# servidor de terceiro, fora da RLS. Ver docs/adr/005-email-transacional.md.
#
# Isto NÃO cobre os e-mails do Supabase Auth (magic link e recuperação de
# senha), que saem pelo SMTP do próprio Supabase. Para produção, configure SMTP
# próprio no painel: Authentication → Emails → SMTP Settings. O SMTP padrão do
# Supabase tem limite baixo e não serve para produção.
# ============================================================================

# `console` (padrão) imprime o e-mail no servidor e não envia nada — a
# aplicação funciona sem credencial. `resend` entrega de verdade.
EMAIL_PROVIDER=console

# Obrigatórias quando EMAIL_PROVIDER=resend.
#
# SEM DOMÍNIO PRÓPRIO: o Resend só libera o remetente de teste
# `onboarding@resend.dev`, e ele só entrega para o e-mail da conta Resend.
# Serve para ver o e-mail chegando de verdade; NÃO serve para convidar outras
# pessoas — para elas, o convite continua saindo pelo link manual.
#
#   EMAIL_REMETENTE="Serenità <onboarding@resend.dev>"
#
# COM DOMÍNIO PRÓPRIO: verifique-o no fornecedor (SPF, DKIM e de preferência
# DMARC) antes de trocar o remetente, senão a entrega vai para spam.
RESEND_API_KEY=
EMAIL_REMETENTE="Serenità <onboarding@resend.dev>"

# ============================================================================
# Google Calendar — Fase 5 (server-only)
# ============================================================================

# Credenciais OAuth2. Escopos: calendar.events, calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Token de verificação do canal de push da Calendar API
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# ============================================================================
# IA — Fase 7 (server-only)
# ============================================================================

# Consumido apenas por server/providers/ai/. Nenhum serviço de domínio importa
# o SDK do fornecedor diretamente. Ver docs/adr/003-ai-provider-abstraction.md.
AI_PROVIDER=openai
OPENAI_API_KEY=

# ============================================================================
# Transcrição — Fase 6 (server-only)
# ============================================================================

# Ver docs/adr/004-transcription-architecture.md
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# ============================================================================
# Notificações — Fase 10 (server-only)
# ============================================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# Observabilidade — Fase 12
# ============================================================================

# Payloads passam por scrubbing antes do envio. Áudio, transcrição bruta e
# conteúdo clínico nunca são enviados. Ver docs/ARCHITECTURE.md §18.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
